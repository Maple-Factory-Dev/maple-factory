# Copy to apps/ios/.env.testflight (gitignored) and fill it in. Read by scripts/testflight.sh;
# a variable already set in the environment wins over this file.

# An App Store Connect API key (Team key, App Manager role): TESTFLIGHT.md, 1.4.
# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys.
# The Key ID is in the key's row.
ASC_KEY_ID=
# The Issuer ID is the UUID shown above the keys list.
ASC_ISSUER_ID=
# The AuthKey_<KEY_ID>.p8 you downloaded (Apple lets you download it once). Keep it outside the repo;
# left empty, ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 is used if it's there.
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Optional. CFBundleVersion for this upload; each upload of a version needs a higher one. Left empty,
# the script uses the UTC time (e.g. 202610312130), which always goes up.
BUILD_NUMBER=

# Optional. Uploads the dSYMs to the maple-ios Sentry project so crash reports have symbols.
# sentry.io → Settings → Auth Tokens (an org token with project:releases), and brew install getsentry/tools/sentry-cli.
SENTRY_AUTH_TOKEN=
