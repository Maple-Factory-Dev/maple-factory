# Copy to apps/mac/.env.release (gitignored) and fill it in. Read by scripts/release.mjs.

# Notarization: a notarytool keychain profile. The one Screenie made works here too; to make one:
#   xcrun notarytool store-credentials maple --apple-id <apple-id> --team-id TU4485Z3KR --password <app-specific-password>
NOTARY_PROFILE=screenie-notary

# The Cloudflare R2 bucket the appcast and DMGs go to, and the public address it's served at
# (a custom domain on the bucket). The app checks UPDATES_URL/appcast.xml; it's built in, so changing
# it later strands the installs that have the old one.
R2_ACCOUNT_ID=8b50749923d4dc5a236cb1ab34852a2e
R2_BUCKET=maplefactory-updates
UPDATES_URL=https://updates.maplefactory.dev

# An R2 API token with Object Read & Write on that bucket. R2 speaks the S3 API, so the aws CLI reads
# these under their usual names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. The default identity is the Developer ID below; the Sparkle key is the login keychain's.
# SIGN_IDENTITY=Developer ID Application: Andrea Fomera (TU4485Z3KR)
# SPARKLE_KEY_FILE=

# Required. A Sentry auth token (project:releases and project:write scopes; Settings › Auth Tokens at
# andrea-fomera.sentry.io) uploads the app's dSYMs, so its crash and hang reports show source lines.
# Without one, `build` and `ship` stop rather than release a build Sentry can't symbolicate;
# MAPLE_SKIP_SYMBOLS=1 is the deliberate way to ship without. For a release that already went out:
#   node apps/mac/scripts/release.mjs symbols 0.2.7 [--app "/path/to/Maple Factory.app"]
SENTRY_AUTH_TOKEN=
