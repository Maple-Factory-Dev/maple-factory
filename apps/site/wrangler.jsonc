{
  // maplefactory.dev: `npx wrangler deploy` from apps/site. The bucket holds the release feed.
  "name": "maplefactory-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // The site's files are served as they are; only /releases/, /download/mac and /push/ run the Worker.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/releases/*", "/download/mac", "/push/*"] },
  // The push relay's enrolled factories (a hash of each secret) and hourly send counts (push.js).
  // No id: wrangler deploy provisions the namespace the first time and keeps it.
  "kv_namespaces": [{ "binding": "PUSH" }],
  "r2_buckets": [{ "binding": "FEED", "bucket_name": "maplefactory-releases" }],
  "routes": [{ "pattern": "maplefactory.dev", "custom_domain": true }]
}
