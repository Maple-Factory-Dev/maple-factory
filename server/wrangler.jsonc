{
  // The config for local dev and for the Deploy to Cloudflare button, which provisions the D1 database
  // and Durable Objects from it and asks for GITHUB_ORG. `maple install` writes a deployment's own
  // config (account, D1 id, domain, org) from this one; nothing here is specific to an org.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maple-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The web app (web/app): static files; its data comes over the signed-in feed like the apps'.
  "assets": { "directory": "./web", "html_handling": "auto-trailing-slash" },
  "dev": { "host": "localhost" },
  "durable_objects": {
    "bindings": [
      { "name": "ORG", "class_name": "OrgHub" },
      { "name": "MACHINE", "class_name": "MachineHub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrgHub", "MachineHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maple",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The factory's files. R2 has to be switched on in the account first: maplefactory.dev/deploy asks
  // before the button, and `maple install` stops and asks. Runner releases put here (an org's own
  // builds) win over maplefactory.dev's feed (src/releases.ts).
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "maple-releases" }],
  "vars": {
    // The GitHub organization whose members may sign in (its login, e.g. "atlas-co"), or a personal
    // account's username, for a factory only that person signs in to.
    "GITHUB_ORG": "",
    // "stable", or "beta" for runner releases before they're stable.
    "RELEASE_CHANNEL": "stable"
  },
  // Every var above is a required field in the Deploy to Cloudflare form, so optional ones aren't listed:
  // GITHUB_ALLOWED_LOGINS (other GitHub logins who may sign in, comma separated) is added in the dashboard
  // (Worker → Settings → Variables and Secrets), and this keeps it when a push redeploys.
  "keep_vars": true
  // The GitHub App (GITHUB_APP_ID, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY,
  // GITHUB_WEBHOOK_SECRET) and SESSION_SECRET are made by /setup and kept in D1; Worker secrets of the
  // same names win. Local dev: .dev.vars, with DEV_LOGIN to skip signing in on localhost.
}
