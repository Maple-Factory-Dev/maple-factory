# The web app and its files, served by Workers Static Assets before the Worker runs: the same headers
# the Worker's own pages send (PAGE_HEADERS in src/util.ts).
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# The offline Mermaid page is framed (sandboxed) by /app's plans and docs (MF-358, MF-363): same-origin only.
/app/mermaid/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
