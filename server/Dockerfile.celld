# maple-server on celld, outside Cloudflare. Build from the repo root:
#   docker build -f server/Dockerfile.celld -t maple-server-celld .
#   docker run -p 8788:8788 -v maple-celld:/app/server/.celld -e GITHUB_ORG=acme maple-server-celld
# State (D1, R2, Durable Objects) lives in /app/server/.celld: keep it on a volume. Vars come from -e
# (written to .dev.vars at start) or a .dev.vars mounted at /app/server/.dev.vars. See server/README.md.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# The workspace manifests first, so the npm layer is reused until dependencies change.
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY server/docs-editor/package.json server/docs-editor/
COPY installer/package.json installer/
# esbuild comes in with wrangler; celld bundles the Worker with it.
RUN npm ci --workspace server --include-workspace-root=false --no-audit --no-fund

COPY server/celld/install.sh server/celld/
RUN CELLD_BIN_DIR=/usr/local/bin sh server/celld/install.sh

COPY server/ server/

ENV CELLD_ESBUILD=/app/node_modules/.bin/esbuild
WORKDIR /app/server
EXPOSE 8788
VOLUME ["/app/server/.celld"]
CMD ["sh", "celld/docker-start.sh"]
